# Any Settings field can be overridden with a CLEANUP_ prefix.
CLEANUP_DATA_DIR=data/raw
CLEANUP_OUTPUT_DIR=data/clean
CLEANUP_MIN_WIDTH=320
CLEANUP_MIN_HEIGHT=320
CLEANUP_BLUR_THRESHOLD=100.0
CLEANUP_BORDERLINE_MARGIN=0.2
CLEANUP_BRIGHTNESS_MIN=30.0
CLEANUP_BRIGHTNESS_MAX=225.0
CLEANUP_MIN_BOX_AREA=0.0001
CLEANUP_ALLOW_EMPTY_LABELS=true
CLEANUP_BORDERLINE_POLICY=keep
# VLM judge (unset = disabled): <provider>:<model>,
# provider = claude | bedrock | bedrock-converse | openai | ollama.
# openai: needs OPENAI_API_KEY and `uv add langchain-openai`.
# OPENAI_API_KEY=...
# bedrock: AWS_PROFILE (needs boto3; wins over the API key; region from the profile unless
# AWS_REGION is set), other AWS credentials (boto3), or AWS_BEARER_TOKEN_BEDROCK.
# bedrock: only Claude models on Bedrock's Mantle endpoint (e.g. claude-opus-5-5).
# bedrock-converse: any Bedrock model via Converse, same AWS auth; needs langchain-aws, e.g.
#   qwen.qwen3-vl-235b-a22b, or global.anthropic.claude-haiku-5-5 (inference-profile id;
#   Claude ids get prompt caching).
# AWS_REGION=us-east-1
# AWS_PROFILE=...
# AWS_BEARER_TOKEN_BEDROCK=...
# survivors = also judge passing images. Claude reads ANTHROPIC_API_KEY (or an `ant` profile).
CLEANUP_JUDGE_MODEL=ollama:qwen2.5vl:7b
CLEANUP_JUDGE_EFFORT=low
CLEANUP_JUDGE_SCOPE=borderline
CLEANUP_JUDGE_MAX_EDGE=1024
# DEBUG logs every judge decision.
CLEANUP_LOG_LEVEL=INFO

# Gallery audit (`cleanup gallery ...`); CLI options override these.
CLEANUP_GALLERY_GALLERY_DIR=../highfive-models/pre_processed/logo_audit_batches_1-10_17-31_with_pseudolabels__2024-11-22__distill-8baece-c0.7
CLEANUP_GALLERY_TARGET_LIST=../highfive-models/highfive_models/data_processing/target_lists/target_logos_2024-11-25.txt
# JSON {"old_name": "new_name"}: LEGACY_LOGO_ALIASES + SPELLING_CORRECTIONS merged.
# CLEANUP_GALLERY_ALIASES=aliases.json
CLEANUP_GALLERY_JUDGE=claude:claude-opus-5-5
CLEANUP_GALLERY_JUDGE_EFFORT=low
CLEANUP_GALLERY_MIN_SIDE_PX=20
CLEANUP_GALLERY_BLUR_MIN=10.0
# Gallery review: extra judge calls when an answer does not match the schema.
# CLEANUP_GALLERY_JUDGE_RETRIES=2
# Gallery UI: seconds between review-progress and spend refreshes.
# CLEANUP_GALLERY_UI_REFRESH_SECONDS=10
# Gallery UI: judges offered for a per-crop second opinion (JSON list).
# CLEANUP_GALLERY_UI_JUDGES=["bedrock-converse:global.anthropic.claude-haiku-5-5","bedrock-converse:qwen.qwen3-vl-235b-a22b"]
